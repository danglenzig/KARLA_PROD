      "/mnt/c/SchoolRepos/PYTHON/KARLA_RECOVER/KARLA_PROD/KARLA_GAMES/the _quiet _conduit/IMAGES/352d2dc3-6cb5-44b1-a543-a20f94b2df72.png",
      "/mnt/c/SchoolRepos/PYTHON/KARLA_RECOVER/KARLA_PROD/KARLA_GAMES/the _quiet _conduit/IMAGES/d5ef8912-cb4f-4cd9-8842-51d1d57a16ce.png"
