                },
                {
                  "type": "line",
                  "character_uuid": "beb43e01-3b29-45b8-8225-854ee51bfd48",
                  "text": "Road's expensive tonight. Lucky for you, I make deliveries."
                },
                {
                  "type": "hide_character",
                  "character_uuid": "beb43e01-3b29-45b8-8225-854ee51bfd48"
