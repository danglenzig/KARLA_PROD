                {
                  "type": "show_character",
                  "character_uuid": "e09f5cd2-3657-4240-b080-f21c190842ae",
                  "character_expression": "happy",
                  "screen_position": "center"
                },
                {
                  "type": "line",
                  "character_uuid": "e09f5cd2-3657-4240-b080-f21c190842ae",
                  "text": "Funny. I just remembered it."
                },
                {
                  "type": "hide_character",
                  "character_uuid": "e09f5cd2-3657-4240-b080-f21c190842ae"
                },
                {
                  "type": "narration",
                  "text": "Nina slips the sealed envelope beneath the sugar caddy. Deke palms it and leaves folded bills under her saucer."
                },
                {
                  "type": "show_character",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83",
                  "character_expression": "happy",
                  "screen_position": "right"
                },
                {
                  "type": "line",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83",
                  "text": "See? Real talent rarely needs applause."
                },
                {
                  "type": "hide_character",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83"
                }
              ]
            },
            {
              "option_id": "hesitant",
              "option_text": "Hesitate and ask just enough to show you're new.",
              "branch_events": [
