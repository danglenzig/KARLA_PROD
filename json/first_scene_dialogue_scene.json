                  "type": "show_character",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83",
                  "character_expression": "cocky",
                  "screen_position": "right"
                },
                {
                  "type": "line",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83",
                  "text": "Cute. Don't get drunk on the feeling."
