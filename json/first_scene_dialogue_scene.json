                {
                  "type": "show_character",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83",
                  "character_expression": "angry",
                  "screen_position": "right"
                },
                {
                  "type": "line",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83",
                  "text": "First rule, baby: innocence gets loud when it's scared."
                },
                {
                  "type": "hide_character",
                  "character_uuid": "b0017685-b6b9-494d-82bf-2b30a479ef83"
                }
              ]
            },
            {
              "option_id": "swagger",
              "option_text": "Lean into the swagger and enjoy the power of it.",
              "branch_events": [
